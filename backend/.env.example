# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=patient-docs

# ─── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Password Reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ─── SendGrid ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourclinic.com
SENDGRID_FROM_NAME=Clinic Name

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Dental Patient Management System
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── Clinic ───────────────────────────────────────────────────────────────────
CLINIC_TIMEZONE=America/New_York
